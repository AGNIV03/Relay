generator client {
  // Prisma 7's Rust-free TypeScript client. Generated into the source tree (no
  // longer node_modules) so it's compiled into dist by tsc.
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
  // supplied to PrismaClient via the driver adapter (see src/lib/prisma.ts).
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  // Bumped to revoke every token this user holds (password change, role change,
  // "sign out everywhere"). Tokens carry the version they were issued at.
  tokenVersion Int @default(0)

  // Privacy. shareActivity=false hides your live listening, play history and
  // likes from other users; allowListenAlong=false stops anyone following you.
  shareActivity    Boolean @default(true)
  allowListenAlong Boolean @default(true)

  // Optional scrobble forwarding (server-side, so every client gets it).
  listenBrainzToken String?
  lastfmSessionKey  String?
  lastfmUsername    String?

  refreshTokens  RefreshToken[]
  invitesCreated InviteCode[]   @relation("InviteCreator")

  playlists Playlist[]
  history   PlayHistory[]
  favorites Favorite[]
  uploads   Track[]       @relation("Uploads")

  playlistCollabs PlaylistCollaborator[]
}

model Artist {
  id     String  @id @default(cuid())
  name   String  @unique
  albums Album[]
  tracks Track[]
}

model Album {
  id        String   @id @default(cuid())
  title     String
  year      Int?
  coverPath String? // path to extracted/located cover art file under DATA_PATH
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks    Track[]
  createdAt DateTime @default(now())

  @@unique([title, artistId])
  @@index([artistId])
}

model Track {
  id       String  @id @default(cuid())
  title    String
  path     String  @unique // absolute path on the server (under MUSIC_PATH)
  duration Float // seconds
  trackNo  Int?
  discNo   Int?
  genre    String?
  format   String? // e.g. "mp3", "flac"
  bitrate  Int? // kbps
  size     Int // bytes

  // SHA-256 of the file contents: exact-duplicate detection across every ingest
  // path (upload, admin upload, scan), independent of tags.
  contentHash String?
  // Identity from AcoustID/MusicBrainz auto-tagging (only when enabled).
  acoustId        String?
  mbRecordingId   String?
  // Integrated loudness (EBU R128, LUFS) measured once at ingest; clients use it
  // for volume normalization (attenuation only, never boosting/clipping).
  loudnessLufs    Float?

  // Lyrics (fetched from LRCLIB by track signature). lyricsSynced is LRC format
  // (timestamped lines) for karaoke-style sync; lyricsPlain is the fallback text.
  lyricsPlain   String?
  lyricsSynced  String?
  lyricsChecked Boolean @default(false) // true once we've attempted a lookup

  // Machine translation of the lyrics to English (for non-English songs).
  lyricsTranslated   String?
  lyricsLang         String? // detected source language (e.g. "ja", "fr", "en")
  lyricsTransChecked Boolean @default(false)

  albumId  String?
  album    Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)
  artistId String
  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  // Who first uploaded this track (null for tracks added by a filesystem scan).
  // The library is global — all tracks are visible to every user regardless.
  uploaderId String?
  uploader   User?   @relation("Uploads", fields: [uploaderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  playlistTracks PlaylistTrack[]
  history        PlayHistory[]
  favorites      Favorite[]

  @@index([albumId])
  @@index([artistId])
  @@index([title])
  @@index([contentHash])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId])
}

model Playlist {
  id          String          @id @default(cuid())
  name        String
  userId      String // owner
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  // Cover art: an auto-generated collage of the playlist's track covers, or a
  // user-uploaded image (coverCustom = true, never auto-regenerated).
  coverPath   String?
  coverCustom Boolean         @default(false)
  // When true the playlist is a public "curated" playlist: it shows in every
  // user's Home "Curated playlists" section, attributed to its owner.
  isPublic    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  collaborators PlaylistCollaborator[]
  playHistory   PlayHistory[]

  @@index([userId])
  @@index([isPublic])
}

// Other users granted edit/view access to a playlist (besides the owner).
model PlaylistCollaborator {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([playlistId, userId])
  @@index([playlistId])
  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

model PlayHistory {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  // The playlist this track was played from (if any), so the Recently Played row
  // can collapse a run of plays into the playlist instead of individual songs.
  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
  @@index([userId, trackId])
  @@index([playlistId])
}

model Setting {
  key   String @id
  value String
}

// Rotating refresh tokens. Each refresh consumes the presented token and issues
// a new one in the same family; presenting an already-used token (reuse = likely
// theft) revokes the whole family.
model RefreshToken {
  id         String    @id // the JWT's jti
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@index([familyId])
}

// Admin-issued invite codes for self-registration.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  role        Role      @default(USER)
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  note        String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// Files refused at ingest (no playable audio, not audio, ...), for the admin
// dashboard. Capped/pruned by the server.
model IngestRejection {
  id        String   @id @default(cuid())
  name      String
  reason    String
  source    String // "upload" | "admin" | "scan"
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

