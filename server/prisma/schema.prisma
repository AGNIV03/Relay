generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  playlists Playlist[]
  favorites Favorite[]
  history   PlayHistory[]
}

model Artist {
  id     String  @id @default(cuid())
  name   String  @unique
  albums Album[]
  tracks Track[]
}

model Album {
  id        String   @id @default(cuid())
  title     String
  year      Int?
  coverPath String? // path to extracted/located cover art file under DATA_PATH
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks    Track[]
  createdAt DateTime @default(now())

  @@unique([title, artistId])
  @@index([artistId])
}

model Track {
  id       String  @id @default(cuid())
  title    String
  path     String  @unique // absolute path on the server (under MUSIC_PATH)
  duration Float // seconds
  trackNo  Int?
  discNo   Int?
  genre    String?
  format   String? // e.g. "mp3", "flac"
  bitrate  Int? // kbps
  size     Int // bytes

  albumId  String?
  album    Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)
  artistId String
  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  playlistTracks PlaylistTrack[]
  favorites      Favorite[]
  history        PlayHistory[]

  @@index([albumId])
  @@index([artistId])
  @@index([title])
}

model Playlist {
  id        String          @id @default(cuid())
  name      String
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]
  createdAt DateTime        @default(now())

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId])
}

model PlayHistory {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
}

model Setting {
  key   String @id
  value String
}
