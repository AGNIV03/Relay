# ─── Copy this file to .env and fill in values ───
# The same .env is shared by docker-compose and the server (like your other projects).

# --- Database ---
POSTGRES_USER=stream
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=stream
# Used by the server (inside Docker the host is "postgres"; running locally it's "localhost")
DATABASE_URL=postgresql://stream:change-me-to-a-long-random-string@localhost:5432/stream?schema=public

# --- Server ---
PORT=4000
# Long random secret for signing JWT access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server REFUSES to start if this is < 32 chars or a placeholder.
JWT_SECRET=

# Absolute path INSIDE the container where your music lives.
# docker-compose maps your host MUSIC_DIR to this path.
MUSIC_PATH=/music
# Where to cache extracted cover art / data on the server
DATA_PATH=/data

# Host folder that holds your audio files (bind-mounted into the container).
# Example (Windows): A:/music   or   D:/Music
MUSIC_DIR=./music

# The very first admin account, created automatically on first boot if no users exist.
# In production the server REFUSES to seed a weak/default password (< 10 chars or a
# common value) — set a strong one. Placeholder ("change-me…") values are refused too.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Browser origins allowed to call the API cross-origin (comma-separated). The web
# app uses a same-origin /api proxy and native apps send no Origin, so this is only
# needed for direct cross-origin browser access. Leave empty to deny all of those.
#   e.g. CORS_ORIGINS=https://music.example.com
CORS_ORIGINS=

# Optional auto-tagging on upload/scan. Get a free application key at
# https://acoustid.org/new-application. When set, each new track's audio
# fingerprint and duration are sent to AcoustID, and MusicBrainz metadata is
# used to fill in missing/placeholder tags. Leave empty to disable.
ACOUSTID_API_KEY=

# --- Web (Next.js) ---
# URL the browser/apps use to reach the API. In prod this is your domain.
NEXT_PUBLIC_API_URL=http://localhost:4000
