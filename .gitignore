# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
.next/
build/

# Prisma 7 generated client (regenerated by `prisma generate` / the build step)
server/src/generated/

# Env / secrets
.env
.env.local
*.local

# Local toolchain (Flutter SDK, JDK, Android SDK/NDK, VS Build Tools, installers).
# All downloaded/installed locally and far too large for GitHub — never commit.
tools/

# Flutter app build artifacts
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.gradle/
app/android/.gradle/

# Music + data (never commit your library or DB)
music/
data/
uploads/
*.sqlite
*.db

# Logs / OS
*.log
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs (personal dev settings — not needed to build)
.vscode/
.idea/
*.iml
*.suo
*.user
*.swp
*.swo
*~

# Misc build/test artifacts not needed for a server deploy
coverage/
*.tsbuildinfo
.eslintcache

# JVM heap dumps from Gradle OOMs
*.hprof
